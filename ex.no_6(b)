from collections import deque
s=input("Enter a String:")
dq=deque()
for ch in s:
    if ch.isalnum():
        dq.append(ch.lower())                
palindrome=True
while len(dq)>1:
    if dq.popleft()!=dq.pop():
         palindrome=False
         break
if palindrome:
    print("Palindrome")
else:
    print("Not a Palindrome")
                        
        
                           
