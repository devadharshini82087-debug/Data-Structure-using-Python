class MaxHeapJobScheduler:
    def __init__(self):
        self.heap = []   
    def parent(self, i):
        return (i - 1) // 2
    def left_child(self, i):
        return 2 * i + 1
    def right_child(self, i):
        return 2 * i + 2
    def swap(self, i, j):
        self.heap[i], self.heap[j] = self.heap[j], self.heap[i]
    def insert_job(self, job_name, priority):
        self.heap.append((priority, job_name))
        i = len(self.heap) - 1
        while i > 0 and self.heap[i][0] > self.heap[self.parent(i)][0]:
            self.swap(i, self.parent(i))
            i = self.parent(i)
        print(f"Job '{job_name}' with priority {priority} inserted successfully.")
    def heapify_down(self, i):
        largest = i
        left = self.left_child(i)
        right = self.right_child(i)
        if left < len(self.heap) and self.heap[left][0] > self.heap[largest][0]:
            largest = left
        if right < len(self.heap) and self.heap[right][0] > self.heap[largest][0]:
            largest = right
        if largest != i:
            self.swap(i, largest)
            self.heapify_down(largest)
    def extract_max(self):
        if len(self.heap) == 0:
            print("No jobs in the scheduler.")
            return None
        max_job = self.heap[0]
        last_element = self.heap.pop()
        if self.heap:
            self.heap[0] = last_element
            self.heapify_down(0)
        print(f"Processed Job: '{max_job[1]}' with priority {max_job[0]}")
        return max_job
    def peek(self):
        if len(self.heap) == 0:
            print("No jobs in the scheduler.")
            return None
        priority, job_name = self.heap[0]
        print(f"Highest Priority Job: '{job_name}' with priority {priority}")
        return self.heap[0]
    def display_jobs(self):
        if len(self.heap) == 0:
            print("No jobs in the scheduler.")
            return
        print("Jobs in Heap Order:")
        for priority, job_name in self.heap:
            print(f"   Job: {job_name}, Priority: {priority}")
scheduler = MaxHeapJobScheduler()
while True:
    print("\n----- JOB SCHEDULER (MAX HEAP) -----")
    print("1. Insert a Job")
    print("2. Delete Highest Priority Job (Extract Max)")
    print("3. Peek Highest Priority Job")
    print("4. Display All Jobs")
    print("5. Exit")
    choice = input("Enter your choice: ")
    if choice == '1':
        job_name = input("Enter Job Name: ")
        priority = int(input("Enter Priority: "))
        scheduler.insert_job(job_name, priority)
    elif choice == '2':
        scheduler.extract_max()
    elif choice == '3':
        scheduler.peek()
    elif choice == '4':
        scheduler.display_jobs()
    elif choice == '5':
        print("Exiting Program...")
        break
    else:
        print("Invalid choice! Please try again.")
