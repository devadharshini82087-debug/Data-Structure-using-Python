def bubble_sort(arr):
    n = len(arr)

    print("Original array:", arr)

    for i in range(n - 1):
        for j in range(n - i - 1):
            if arr[j] > arr[j + 1]:
                arr[j], arr[j + 1] = arr[j + 1], arr[j]

        print("Pass", i + 1, ":", arr)

    print("Finally sorted array:", arr)


n = int(input("Enter number of elements: "))
arr = []

for i in range(n):
    element = int(input("Enter element: "))
    arr.append(element)

bubble_sort(arr)
