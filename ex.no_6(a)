def infix_to_postfix(expression):
    precedence={'+':1,'-':1,'*':2,'/':2,'^':3}
    stack=[]
    postfix=""
    for ch in expression:
        if ch.isalnum():
            postfix+=ch
        elif ch=='(':
            stack.append(ch)
        elif ch==')':
            while stack and stack[-1]!='(':
                postfix+=stack.pop()
            stack.pop()
        else:
            while(stack and stack[-1]!='(' and precedence.get(ch,0)<=precedence.get(stack[-1],0)):
                postfix+=stack.pop()
            stack.append(ch)                    
    while stack:
        postfix+=stack.pop()
    return postfix
expr=input("Enter infix expression:")
print("Postfix expression:",infix_to_postfix(expr))
                           
    
